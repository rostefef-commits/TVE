<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Общие цвета (светлая тема) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#2C2C2C"/>

    <!-- Акцент и состояния круга -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7DFF"/>
    <SolidColorBrush x:Key="MicIdleBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="MicRecordingBrush" Color="#43A047"/>
    <SolidColorBrush x:Key="MicExpectingNameBrush" Color="#FDD835"/>
    <SolidColorBrush x:Key="MicNoDeviceBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="MicDropFileBrush" Color="#1E88E5"/>

    <!-- Панели и предупреждения -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#EF6C00"/>
</ResourceDictionary>