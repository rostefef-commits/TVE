<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Общие цвета (тёмная тема) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#EAEAEA"/>

    <!-- Акцент и состояния круга -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A9EFF"/>
    <SolidColorBrush x:Key="MicIdleBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="MicRecordingBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="MicExpectingNameBrush" Color="#FFEB3B"/>
    <SolidColorBrush x:Key="MicNoDeviceBrush" Color="#757575"/>
    <SolidColorBrush x:Key="MicDropFileBrush" Color="#42A5F5"/>

    <!-- Панели и предупреждения -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D"/>
</ResourceDictionary>