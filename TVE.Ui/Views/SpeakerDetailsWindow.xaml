<Window x:Class="TVE.Ui.Views.SpeakerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали голоса" Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/tve.ico"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="Детали голоса"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextBrush}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Описание:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DescriptionText" Text="-" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.9"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Кластер:" Margin="0,4"
                                   Foreground="{DynamicResource AppTextBrush}" Opacity="0.7"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ClusterText" Text="-"
                                   Margin="0,4" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Реплик в истории:" Margin="0,4"
                                   Foreground="{DynamicResource AppTextBrush}" Opacity="0.7"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UtterancesText" Text="-"
                                   Margin="0,4" Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Среднее сходство в кластере:" Margin="0,4"
                                   Foreground="{DynamicResource AppTextBrush}" Opacity="0.7"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AvgSimText" Text="-"
                                   Margin="0,4" Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Первое взаимодействие:" Margin="0,4"
                                   Foreground="{DynamicResource AppTextBrush}" Opacity="0.7"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FirstSeenText" Text="-"
                                   Margin="0,4" Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Последнее взаимодействие:" Margin="0,4"
                                   Foreground="{DynamicResource AppTextBrush}" Opacity="0.7"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastSeenText" Text="-"
                                   Margin="0,4" Foreground="{DynamicResource AppTextBrush}"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Ближайшие по голосу:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="NeighborsPanel"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть"
                Width="120" Height="36" HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Style="{StaticResource BottomButtonStyle}"
                Click="Close_Click"/>
    </Grid>
</Window>