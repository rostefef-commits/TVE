<UserControl x:Class="TVE.Ui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,30,60,20">

                <TextBlock Text="Настройки" FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,30"/>

                <!-- ======= УСТРОЙСТВО ВВОДА ======= -->
                <TextBlock Text="Устройство ввода" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,8"/>
                <ComboBox x:Name="InputDeviceCombo"
                          FontSize="14" Height="36" Padding="10,0"
                          SelectionChanged="InputDeviceCombo_SelectionChanged"/>

                <!-- ======= ЦВЕТОВАЯ СХЕМА ======= -->
                <TextBlock Text="Цветовая схема" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,30,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeLight" Content="Светлая"
                                 GroupName="Theme" FontSize="14" Margin="0,0,20,0"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 Checked="Theme_Checked" Tag="Light"/>
                    <RadioButton x:Name="ThemeDark" Content="Тёмная"
                                 GroupName="Theme" FontSize="14" Margin="0,0,20,0"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 Checked="Theme_Checked" Tag="Dark"/>
                    <RadioButton x:Name="ThemeSystem" Content="Системная"
                                 GroupName="Theme" FontSize="14"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 Checked="Theme_Checked" Tag="System"/>
                </StackPanel>

                <!-- ======= ПАПКА ХРАНЕНИЯ ======= -->
                <TextBlock Text="Папка хранения данных" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,30,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="DbPathText" FontSize="13"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   TextWrapping="Wrap" Opacity="0.8"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="1" Content="Изменить"
                            Height="40" Padding="14,0" Margin="10,0,0,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="ChangeDbFolder_Click"/>

                    <Button Grid.Column="2" Content="Открыть"
                            Height="40" Padding="14,0" Margin="8,0,0,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="OpenDbFolder_Click"/>
                </Grid>
                <TextBlock x:Name="DbChangeHint" Text=""
                           FontSize="12" Opacity="0.7" Margin="0,6,0,0"
                           Foreground="{DynamicResource WarningBrush}"
                           Visibility="Collapsed"/>

                <!-- ======= ЭКСПОРТ / ИМПОРТ БАЗЫ ======= -->
                <TextBlock Text="Резервное копирование" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,30,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="💾 Экспорт базы"
                            Height="40" Padding="16,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="ExportDatabase_Click"/>

                    <Button Grid.Column="1" Content="📥 Импорт базы"
                            Height="40" Padding="16,0" Margin="10,0,0,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="ImportDatabase_Click"/>

                    <TextBlock Grid.Column="2"
                               Text="Экспорт - сохранить копию текущей базы. Импорт - загрузить базу из резервной копии."
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </Grid>

                <!-- ======= ДИАГНОСТИКА ======= -->
                <TextBlock Text="Диагностика" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}" Margin="0,30,0,8"/>
                <CheckBox x:Name="CreateDiagnosticFilesCheck"
                          Content="Создавать диагностические файлы (debug_segments, debug_decoded)"
                          FontSize="14"
                          Foreground="{DynamicResource AppTextBrush}"
                          Checked="CreateDiagnosticFiles_Changed"
                          Unchecked="CreateDiagnosticFiles_Changed"/>
                <TextBlock Text="Сохраняет все сегменты речи и декодированные MP3-файлы на рабочий стол. Полезно для отладки распознавания. Рекомендуется отключать при обычной работе."
                           FontSize="12" Opacity="0.6" Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}"/>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="←  Назад" HorizontalAlignment="Right"
                Margin="0,0,20,10" Height="40" Padding="20,0"
                Style="{StaticResource BottomButtonStyle}" Click="BtnBack_Click"/>
    </Grid>
</UserControl>