<Window x:Class="TVE.Ui.Views.ExportFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт эмбеддингов"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="560" MinHeight="520"
        Icon="pack://application:,,,/Assets/tve.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TitleBarText"
                       Text="Экспорт эмбеддингов"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource TitleBarTextBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="✕" Width="42" Height="36"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- КОНТЕНТ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,20,0">
            <StackPanel>

                <TextBlock x:Name="ContextText"
                           Text="Выберите формат экспорта:"
                           FontSize="13" Opacity="0.8"
                           Foreground="{DynamicResource AppTextBrush}"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"/>

                <!-- СЕКЦИЯ 1: КОГО ЭКСПОРТИРОВАТЬ -->
                <StackPanel x:Name="SelectionSection">
                    <TextBlock Text="1. Кого экспортировать"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"
                               Margin="0,0,0,8"/>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0"
                                     x:Name="SpeakersListBox"
                                     MaxHeight="220"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Content="{Binding DisplayName}"
                                                  Foreground="{DynamicResource AppTextBrush}"
                                                  FontSize="13"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="6,8,6,4">
                                <Button Content="Выбрать всех"
                                        Height="26" Padding="12,0"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource BottomButtonStyle}"
                                        FontSize="12"
                                        Click="SelectAll_Click"/>
                                <Button Content="Снять всех"
                                        Height="26" Padding="12,0"
                                        Style="{StaticResource BottomButtonStyle}"
                                        FontSize="12"
                                        Click="DeselectAll_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- СЕКЦИЯ 2: ФОРМАТ -->
                <TextBlock Text="2. Формат файла"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"
                           Margin="0,0,0,8"/>

                <!-- Широкий -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <RadioButton x:Name="RadioWide"
                                 GroupName="Format"
                                 IsChecked="True"
                                 VerticalContentAlignment="Top"
                                 Foreground="{DynamicResource AppTextBrush}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextBrush}">
                                <Run Text="Широкий формат"/>
                                <Run Text="  (рекомендуется)"
                                     Foreground="#43A047" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Opacity="0.75"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Text="Имя;v1;v2;...;v512 - одна строка на говорящего. Компактно, удобно для Excel, легко сравнивать несколько голосов в одной таблице."/>
                        </StackPanel>
                    </RadioButton>
                </Border>

                <!-- Длинный -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14,12">
                    <RadioButton x:Name="RadioLong"
                                 GroupName="Format"
                                 VerticalContentAlignment="Top"
                                 Foreground="{DynamicResource AppTextBrush}">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Text="Длинный формат"/>
                            <TextBlock FontSize="12" Opacity="0.75"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Text="Имя;Номер;Значение - 512 строк на говорящего. Удобно для статистических инструментов и Python/pandas, но файл получается большой."/>
                        </StackPanel>
                    </RadioButton>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- КНОПКИ -->
        <Border Grid.Row="2" Padding="20,16,20,16" BorderThickness="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="120" Height="36"
                        Margin="0,0,10,0"
                        Style="{StaticResource BottomButtonStyle}"
                        IsCancel="True"
                        Click="Cancel_Click"/>

                <Button x:Name="ExportButton"
                        Content="Экспортировать (0)"
                        Width="180" Height="36"
                        Style="{StaticResource BottomButtonStyle}"
                        IsDefault="True"
                        Click="Export_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>