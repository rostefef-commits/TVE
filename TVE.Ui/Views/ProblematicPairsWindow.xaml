<Window x:Class="TVE.Ui.Views.ProblematicPairsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проблемные пары" Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/tve.ico"
        Background="{DynamicResource AppBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ThresholdSpinButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кастомный заголовок -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TitleBarText" Text="Проблемные пары"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarTextBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnMinimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="☐" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnMaximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="✕" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                Padding="16,12">
            <TextBlock x:Name="HeaderText" Text="Проблемные пары голосов"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarTextBrush}"/>
        </Border>

        <!-- Панель порога -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Порог сходства:"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <ComboBox Grid.Row="0" Grid.Column="1"
                          x:Name="ThresholdCombo"
                          Width="80" Height="28"
                          Margin="0,0,4,0"
                          MaxDropDownHeight="260"
                          SelectionChanged="Threshold_Changed"/>

                <StackPanel Grid.Row="0" Grid.Column="2"
                            Orientation="Vertical" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <Button Content="▲"
                            Style="{StaticResource ThresholdSpinButton}"
                            Click="ThresholdUp_Click"
                            ToolTip="Увеличить порог на 0.05"/>
                    <Button Content="▼"
                            Style="{StaticResource ThresholdSpinButton}"
                            Margin="0,2,0,0"
                            Click="ThresholdDown_Click"
                            ToolTip="Уменьшить порог на 0.05"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           x:Name="CountText"
                           VerticalAlignment="Center"
                           FontSize="13" Opacity="0.7"
                           Foreground="{DynamicResource AppTextBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                           TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource AppTextBrush}">
                    <Run Text="Рекомендуется "/>
                    <Run Text="0.50 - 0.55" FontWeight="SemiBold"/>
                    <Run Text=": ниже - увидите больше потенциальных рисков, выше - только серьёзные случаи."/>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Эти пары голосов находятся в разных кластерах, но очень похожи. Программа может их перепутать при идентификации."
                   FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextBrush}"
                   Margin="20,12,20,12"/>

        <Grid Grid.Row="4" Margin="20,0,20,0">
            <Border x:Name="ListContainer"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="6">
                <ListView x:Name="PairsList"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,4"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}">
                                            <Run Text="{Binding NameA}"/>
                                            <Run Text=" ↔ "/>
                                            <Run Text="{Binding NameB}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClustersText}"
                                                   FontSize="11" Opacity="0.6"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SimilarityText}"
                                               FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="#C62828"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock x:Name="EmptyText"
                       Text="Проблемных пар не найдено. При текущем пороге все голоса хорошо разделены."
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource AppTextBrush}"
                       Visibility="Collapsed"/>
        </Grid>

        <Button Grid.Row="5" Content="Закрыть"
                Width="140" Height="36" HorizontalAlignment="Right"
                Margin="20,16,20,20"
                Style="{StaticResource BottomButtonStyle}"
                Click="Close_Click"/>
    </Grid>
</Window>