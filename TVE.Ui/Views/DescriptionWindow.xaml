<Window x:Class="TVE.Ui.Views.DescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Описание" Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="Описание"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource AppTextBrush}"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" x:Name="DescriptionBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="14" Padding="10"
                 Background="{DynamicResource ButtonBackgroundBrush}"
                 Foreground="{DynamicResource AppTextBrush}"
                 BorderBrush="{DynamicResource PanelBorderBrush}"
                 BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Height="36" Margin="0,0,10,0"
                    Style="{StaticResource BottomButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="120" Height="36"
                    Style="{StaticResource BottomButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
