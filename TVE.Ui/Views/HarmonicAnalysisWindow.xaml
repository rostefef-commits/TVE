<Window x:Class="TVE.Ui.Views.HarmonicAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="TVE - Анализ гармоник"
        Width="1400" Height="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/tve.ico"
        Background="{DynamicResource AppBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Шапка колонки -->
        <Style x:Key="GridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ButtonBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка таблицы -->
        <Style x:Key="GridRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ОКНА ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="TVE - Анализ гармоник"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarTextBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnMinimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="☐" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnMaximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="✕" Width="46" Height="40"
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="BtnClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ============ ИНФО О ФАЙЛЕ ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="FileNameText"
                           Text="-"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBarTextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="FileStatsText"
                           Text="-"
                           FontSize="12" Opacity="0.7"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TitleBarTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ ПАНЕЛЬ F0 / RMS / SNR ============ -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="16,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Основная частота F0"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBlock x:Name="F0Text" Text="-"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBlock x:Name="F0DetailText" Text=""
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="RMS (громкость)"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBlock x:Name="RmsText" Text="-"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="SNR (сигнал/шум)"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBlock x:Name="SnrText" Text="-"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Согласие F0"
                               FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBlock x:Name="F0AgreedText" Text="-"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ ГРАФИКИ + ТАБЛИЦЫ ============ -->
        <Grid Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Графики: спектрограмма сверху, waveform снизу -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>

                <!-- СПЕКТРОГРАММА -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="4">
                    <oxy:PlotView x:Name="SpectrogramPlot"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                </Border>

                <!-- WAVEFORM -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="4">
                    <oxy:PlotView x:Name="WaveformPlot"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                </Border>
            </Grid>

            <!-- ТАБЛИЦЫ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ГАРМОНИКИ -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Гармоники k1..k8"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource AppTextBrush}"/>

                        <ListView Grid.Row="1"
                                  x:Name="HarmonicsList"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  ItemContainerStyle="{StaticResource GridRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                    <GridViewColumn Header="Номер" Width="60"
                                                    DisplayMemberBinding="{Binding NumberText}"/>
                                    <GridViewColumn Header="Частота" Width="110"
                                                    DisplayMemberBinding="{Binding FrequencyText}"/>
                                    <GridViewColumn Header="Ампл." Width="100"
                                                    DisplayMemberBinding="{Binding AmplitudeText}"/>
                                    <GridViewColumn Header="дБ" Width="90"
                                                    DisplayMemberBinding="{Binding AmplitudeDbText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- ФОРМАНТЫ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Форманты F1..F4"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource AppTextBrush}"/>

                        <ListView Grid.Row="1"
                                  x:Name="FormantsList"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource AppTextBrush}"
                                  ItemContainerStyle="{StaticResource GridRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                    <GridViewColumn Header="Номер" Width="70"
                                                    DisplayMemberBinding="{Binding NumberText}"/>
                                    <GridViewColumn Header="Частота" Width="200"
                                                    DisplayMemberBinding="{Binding FrequencyText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ ЛЕГЕНДА + КНОПКИ ЭКСПОРТА ============ -->
        <Border Grid.Row="4"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕГЕНДА -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Обозначения на спектрограмме:"
                               FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource AppTextBrush}"/>

                    <!-- Образец линии гармоник: цвет линии и фон плашки
                         адаптируются под текущую тему -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            Padding="4,3"
                            CornerRadius="3" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Canvas Width="36" Height="6">
                            <Line X1="0" Y1="3" X2="36" Y2="3"
                                  Stroke="{DynamicResource AppTextBrush}"
                                  StrokeThickness="2"
                                  StrokeDashArray="4,2"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="Гармоники k1..k8"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               Foreground="{DynamicResource AppTextBrush}"/>

                    <!-- Образец линии формант -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            Padding="4,3"
                            CornerRadius="3" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Canvas Width="36" Height="6">
                            <Line X1="0" Y1="3" X2="36" Y2="3"
                                  Stroke="#FF2020"
                                  StrokeThickness="2.5"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="Форманты F1..F4"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextBrush}"/>
                </StackPanel>

                <!-- КНОПКИ -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📁  Экспорт в CSV"
                            Height="34" Padding="16,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="BtnExportCsv_Click"
                            ToolTip="Сохранить результаты в CSV (разделитель точка с запятой)"/>

                    <Button Content="🖼  Экспорт в PNG"
                            Height="34" Padding="16,0"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="BtnExportPng_Click"
                            ToolTip="Сохранить спектрограмму как изображение"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>